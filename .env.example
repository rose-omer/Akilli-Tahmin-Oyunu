# Neon: uygulama pooler adresini, CLI (migrate) doğrudan adresi kullanır.
DATABASE_URL="postgresql://kullanici:parola@ep-ornek-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://kullanici:parola@ep-ornek.eu-central-1.aws.neon.tech/neondb?sslmode=require"
# Yalnız `npm run db:diff` için: boş bir Postgres veritabanı.
SHADOW_DATABASE_URL=""

# Gemini (isteğe bağlı). Boşsa tahminleri yalnız soru ağacı ve öğrenen motor yapar.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"

# Hız sınırı: IP özeti başına dakikadaki istek sayısı.
RATE_LIMIT_PER_MINUTE="30"
# IP özeti tuzu ve tahmin jetonu anahtarı. DATABASE_URL ya da Vercel varsa zorunlu (en az 16 karakter).
# Üret: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
IP_HASH_SALT=""
# Öğrenen motorun oyunu baştan yönetmesi için gereken kayıtlı oyun sayısı.
ENGINE_MIN_GAMES="25"
# Ağaçta olmayan yeni varlığın motora girmesi için gereken oyun sayısı.
ENTITY_MIN_GAMES="2"
# Vercel dışında: X-Forwarded-For'a adres ekleyen güvenilir proxy sayısı.
TRUSTED_PROXY_HOPS="1"
# /yonetim soru onayı parolası (en az 16 karakter). Boşsa sayfa kapalı.
ADMIN_TOKEN=""
# Yalnız entegrasyon testi: migration uygulanmış boş Postgres.
TEST_DATABASE_URL=""
